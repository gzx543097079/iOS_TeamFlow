new file mode 100644
index 0000000000000000000000000000000000000000..470d9314e4d4facdf0195238b9bd112be5440361
--- /dev/null
+++ b/App/TeamFlowDemo/Sources/SceneDelegate.swift
@@ -0,0 +1,22 @@
+import UIKit
+
+/// 持有当前场景的窗口与主题绑定，避免依赖全局屏幕尺寸创建界面。
+final class SceneDelegate: UIResponder, UIWindowSceneDelegate {
+    var window: UIWindow?
+    private var appearanceBinding: DemoAppearanceBinding?
+
+    func scene(
+        _ scene: UIScene,
+        willConnectTo session: UISceneSession,
+        options connectionOptions: UIScene.ConnectionOptions
+    ) {
+        guard let windowScene = scene as? UIWindowScene else { return }
+        let window = UIWindow(windowScene: windowScene)
+        window.rootViewController = UINavigationController(rootViewController: DemoViewController())
+        // 首帧显示前应用已保存的外观；绑定随场景持有，后台切换不重建页面。
+        appearanceBinding = DemoAppearanceBinding(window: window, preferences: .shared)
+        self.window = window
+        window.makeKeyAndVisible()
+        TFLog.debug("Demo 窗口场景已连接")
+    }
+}

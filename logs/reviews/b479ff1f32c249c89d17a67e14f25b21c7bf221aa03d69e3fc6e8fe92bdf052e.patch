 final class DemoTests: XCTestCase {
+    func testLogMessageEvaluationMatchesBuildConfiguration() {
+        var count = 0
+        func message() -> String { count += 1; return "本地测试消息" }
+        TFLog.debug(message())
+        TFLog.info(message())
+        TFLog.warning(message())
+        TFLog.error(message())
+        TFLog.fault(message())

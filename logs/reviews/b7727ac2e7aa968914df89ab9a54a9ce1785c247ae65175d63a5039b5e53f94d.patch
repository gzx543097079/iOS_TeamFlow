diff --git a/App/TeamFlowDemo/Sources/Support/MasonryLayout.swift b/App/TeamFlowDemo/Sources/Support/MasonryLayout.swift
new file mode 100644
index 0000000000000000000000000000000000000000..4979f2c5160bbe3d7eff478e92ec5eebb4db9d23
--- /dev/null
+++ b/App/TeamFlowDemo/Sources/Support/MasonryLayout.swift
@@ -0,0 +1,9 @@
+import UIKit
+
+extension UILayoutGuide {
+    /// 保留布局指南为约束对象，同时提供所属视图供 Masonry 寻找公共父视图。
+    /// 仅在指南已经归属视图后调用，适用于安全区域和滚动视图的两种指南。
+    func masAttribute(_ attribute: NSLayoutConstraint.Attribute) -> MASViewAttribute {
+        MASViewAttribute(view: owningView, item: self, layoutAttribute: attribute)
+    }
+}

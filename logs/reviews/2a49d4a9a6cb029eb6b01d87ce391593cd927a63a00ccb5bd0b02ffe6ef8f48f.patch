index 0000000000000000000000000000000000000000..9eaf0debdf52bfa7e807cb9dd84ac620a0b2addf
--- /dev/null
+++ b/App/TeamFlowDemo/Sources/Shared/Logging/TFLogger.swift
@@ -0,0 +1,54 @@
+import Foundation
+
+/// 仅在定义 DEBUG 的构建中输出业务日志；没有全局可变配置。
+public enum TFLog {
+    /// 五个等级均默认输出，等级只描述严重程度，不触发崩溃或上报。
+    public enum Level: String {
+        case debug = "DEBUG"
+        case info = "INFO"
+        case warning = "WARNING"
+        case error = "ERROR"
+        case fault = "FAULT"
+    }
+
+    /// 延迟生成消息，Release 下不会执行插值、函数调用或其他消息表达式。
+    public static func log(
+        _ level: Level, _ message: @autoclosure () -> String,
+        file: StaticString = #fileID, function: StaticString = #function, line: UInt = #line
+    ) {
+        #if DEBUG
+        // 使用固定格式串，避免把消息中的百分号当成格式指令。
+        NSLog("%@", "[TFLog][\(level.rawValue)] [\(file):\(line) \(function)] \(message())")
+        #endif
+    }
+
+    /// 输出开发排错信息，自动保留实际调用位置。
+    public static func debug(_ message: @autoclosure () -> String, file: StaticString = #fileID,
+                             function: StaticString = #function, line: UInt = #line) {
+        log(.debug, message(), file: file, function: function, line: line)
+    }
+
+    /// 输出正常业务过程中的重要信息。
+    public static func info(_ message: @autoclosure () -> String, file: StaticString = #fileID,
+                            function: StaticString = #function, line: UInt = #line) {
+        log(.info, message(), file: file, function: function, line: line)
+    }
+
+    /// 输出可恢复的异常情况。
+    public static func warning(_ message: @autoclosure () -> String, file: StaticString = #fileID,
+                               function: StaticString = #function, line: UInt = #line) {
+        log(.warning, message(), file: file, function: function, line: line)
+    }
+
+    /// 输出操作失败的信息，不替代业务错误处理。
+    public static func error(_ message: @autoclosure () -> String, file: StaticString = #fileID,
+                             function: StaticString = #function, line: UInt = #line) {
+        log(.error, message(), file: file, function: function, line: line)
+    }
+
+    /// 输出严重异常信息；本方法不会终止进程。
+    public static func fault(_ message: @autoclosure () -> String, file: StaticString = #fileID,
+                             function: StaticString = #function, line: UInt = #line) {
+        log(.fault, message(), file: file, function: function, line: line)
+    }
+}
diff --git a/App/TeamFlowDemo/Sources/Shared/Models/DemoCatalog.swift b/App/TeamFlowDemo/Sources/Shared/Models/DemoCatalog.swift
new file mode 100644
index 0000000000000000000000000000000000000000..3b678b5c83e50aeb976e1047f616ec9a75423078
--- /dev/null
+++ b/App/TeamFlowDemo/Sources/Shared/Models/DemoCatalog.swift
@@ -0,0 +1,39 @@
+import Foundation
+
+/// 本地展示商品，金额以分保存，避免购物袋汇总的浮点误差。
+struct DemoProduct: Equatable {
+    enum Category: String, CaseIterable { case all, audio, daily }
+    let id: String
+    let category: Category
+    let symbol: String
+    let priceCents: Int
+    var nameKey: String { "product.\(id).name" }
+    var descriptionKey: String { "product.\(id).description" }
+
+    static let catalog = [
+        DemoProduct(id: "headphones", category: .audio, symbol: "headphones", priceCents: 29900),
+        DemoProduct(id: "bag", category: .daily, symbol: "bag.fill", priceCents: 8900),
+        DemoProduct(id: "speaker", category: .audio, symbol: "hifispeaker.fill", priceCents: 19900),
+        DemoProduct(id: "keyboard", category: .daily, symbol: "keyboard", priceCents: 15900)
+    ]
+
+    static func filtered(by category: Category) -> [DemoProduct] {
+        catalog.filter { category == .all || $0.category == category }
+    }
+
+}
+
+/// 购物袋仅在本次运行内保存，商品来自本地目录，不提交订单或调用支付。
+final class DemoBag {
+    private(set) var quantities: [String: Int] = [:]
+    var products: [DemoProduct] { DemoProduct.catalog.filter { quantities[$0.id] != nil } }
+    var count: Int { quantities.values.reduce(0, +) }
+    var totalCents: Int { products.reduce(0) { $0 + $1.priceCents * (quantities[$1.id] ?? 0) } }
+    func add(_ product: DemoProduct) {
+        guard DemoProduct.catalog.contains(product) else { return }
+        quantities[product.id, default: 0] += 1
+        TFLog.debug("Demo 购物袋已添加商品")
+    }
+    func remove(_ product: DemoProduct) { quantities.removeValue(forKey: product.id) }
+}
+

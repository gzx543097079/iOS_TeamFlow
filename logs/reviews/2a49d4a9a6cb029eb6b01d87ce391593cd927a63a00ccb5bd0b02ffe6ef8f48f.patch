diff --git a/App/TeamFlowDemo/Sources/Application/DemoAppearanceBinding.swift b/App/TeamFlowDemo/Sources/Application/DemoAppearanceBinding.swift
new file mode 100644
index 0000000000000000000000000000000000000000..21fea1820e3954ebc5fd2a57d3bc57f45bca67b3
--- /dev/null
+++ b/App/TeamFlowDemo/Sources/Application/DemoAppearanceBinding.swift
@@ -0,0 +1,28 @@
+import UIKit
+
+extension DemoPreferences.Appearance {
+    /// UIKit 外观值只在窗口适配层转换，偏好模型不依赖 UI 框架。
+    var interfaceStyle: UIUserInterfaceStyle {
+        switch self {
+        case .system: return .unspecified
+        case .light: return .light
+        case .dark: return .dark
+        }
+    }
+}
+
+/// 窗口级外观覆盖统一作用于导航栏和所有页面，跟随系统不固定亮暗。
+final class DemoAppearanceBinding {
+    private var observer: NSObjectProtocol?
+    init(window: UIWindow, preferences: DemoPreferences) {
+        window.overrideUserInterfaceStyle = preferences.appearance.interfaceStyle
+        observer = NotificationCenter.default.addObserver(
+            forName: DemoPreferences.appearanceDidChange, object: preferences, queue: .main
+        ) { [weak window] _ in
+            window?.overrideUserInterfaceStyle = preferences.appearance.interfaceStyle
+        }
+    }
+    deinit {
+        if let observer = observer { NotificationCenter.default.removeObserver(observer) }
+    }
+}
diff --git a/App/TeamFlowDemo/Sources/Application/DemoCoordinator.swift b/App/TeamFlowDemo/Sources/Application/DemoCoordinator.swift
new file mode 100644
index 0000000000000000000000000000000000000000..65a23e7de6cffe7ffd490a35ab3504a0a66036c2
--- /dev/null
+++ b/App/TeamFlowDemo/Sources/Application/DemoCoordinator.swift
@@ -0,0 +1,42 @@
+import UIKit
+
+/// 场景内唯一组装点：共享购物袋与偏好，协调功能间导航，不承载页面业务规则。
+final class DemoCoordinator {
+    let navigationController = UINavigationController()
+    private let preferences: PreferencesStore
+    private let bag: DemoBag
+    private let events: DemoEventRecording
+    init(preferences: PreferencesStore, bag: DemoBag = DemoBag(), events: DemoEventRecording = DemoEvents()) {
+        self.preferences = preferences
+        self.bag = bag
+        self.events = events
+    }
+    func start() {
+        let page = DemoViewController(viewModel: StoreViewModel(preferences: preferences, bag: bag, events: events))
+        page.onOpenProduct = { [weak self] product in
+            guard let self = self else { return }
+            self.navigationController.pushViewController(ProductViewController(viewModel: ProductViewModel(product: product, preferences: self.preferences, bag: self.bag)), animated: true)
+        }
+        page.onOpenBag = { [weak self] in
+            guard let self = self else { return }
+            self.navigationController.pushViewController(BagViewController(viewModel: BagViewModel(preferences: self.preferences, bag: self.bag)), animated: true)
+        }
+        page.onOpenSettings = { [weak self] in self?.showSettings() }
+        navigationController.setViewControllers([page], animated: false)
+    }
+    private func showSettings() {
+        let page = SettingsViewController(viewModel: SettingsViewModel(preferences: preferences))
+        page.navigationItem.largeTitleDisplayMode = .never
+        page.onSelect = { [weak self] destination in
+            guard let self = self else { return }
+            let child: UIViewController
+            switch destination {
+            case .language: child = ChoiceViewController(viewModel: LanguageViewModel(preferences: self.preferences))
+            case .appearance: child = ChoiceViewController(viewModel: AppearanceViewModel(preferences: self.preferences))
+            case .about: child = AboutViewController(viewModel: AboutViewModel(preferences: self.preferences, version: Bundle.main.object(forInfoDictionaryKey: "CFBundleShortVersionString") as? String ?? "1.0", build: Bundle.main.object(forInfoDictionaryKey: "CFBundleVersion") as? String ?? "1"))
+            }
+            self.navigationController.pushViewController(child, animated: true)
+        }
+        navigationController.pushViewController(page, animated: true)
+    }
+}
diff --git a/App/TeamFlowDemo/Sources/Application/SceneDelegate.swift b/App/TeamFlowDemo/Sources/Application/SceneDelegate.swift
new file mode 100644
index 0000000000000000000000000000000000000000..a99e4ea1207c487ca43c794db8b47f6f58d8e6b1
--- /dev/null
+++ b/App/TeamFlowDemo/Sources/Application/SceneDelegate.swift
@@ -0,0 +1,26 @@
+import UIKit
+
+/// 持有当前场景的窗口与主题绑定，避免依赖全局屏幕尺寸创建界面。
+final class SceneDelegate: UIResponder, UIWindowSceneDelegate {
+    var window: UIWindow?
+    private var coordinator: DemoCoordinator?
+    private var appearanceBinding: DemoAppearanceBinding?
+
+    func scene(
+        _ scene: UIScene,
+        willConnectTo session: UISceneSession,
+        options connectionOptions: UIScene.ConnectionOptions
+    ) {
+        guard let windowScene = scene as? UIWindowScene else { return }
+        let window = UIWindow(windowScene: windowScene)
+        let coordinator = DemoCoordinator(preferences: DemoPreferences.shared)
+        coordinator.start()
+        self.coordinator = coordinator
+        window.rootViewController = coordinator.navigationController
+        // 首帧显示前应用已保存的外观；绑定随场景持有，后台切换不重建页面。
+        appearanceBinding = DemoAppearanceBinding(window: window, preferences: .shared)
+        self.window = window
+        window.makeKeyAndVisible()
+        TFLog.debug("Demo 窗口场景已连接")
+    }
+}

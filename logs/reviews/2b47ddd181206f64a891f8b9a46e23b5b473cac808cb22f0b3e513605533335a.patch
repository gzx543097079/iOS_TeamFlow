+name: iOS 测试工程
+on:
+  pull_request:
+    paths:
+      - 'App/**'
+      - 'scripts/test_demo.py'
+      - '.agents/project-checks.json'
+      - '.agents/skills/ios-team-flow/scripts/project_checks.py'
+      - '.github/workflows/ios-demo-tests.yml'
+  push:
+    paths:
+      - 'App/**'
+      - 'scripts/test_demo.py'
+      - '.agents/project-checks.json'
+      - '.agents/skills/ios-team-flow/scripts/project_checks.py'
+      - '.github/workflows/ios-demo-tests.yml'
+  workflow_dispatch:
+permissions:
+  contents: read
+jobs:
+  simulator:
+    runs-on: macos-15
+    timeout-minutes: 25
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          persist-credentials: false
+      - uses: actions/setup-python@v5
+        with:
+          python-version: '3.12'
+      - name: 使用 runner 已选定的 Xcode
+        run: echo "DEVELOPER_DIR=$(xcode-select -p)" >> "$GITHUB_ENV"
+      - name: 执行模拟器构建、单测和 UI 测试
+        run: python3 .agents/skills/ios-team-flow/scripts/project_checks.py --project . run --profile ios-demo
+      - name: 保留运行证据（包括失败结果）
+        if: always()
+        uses: actions/upload-artifact@v4
+        with:
+          name: ios-demo-evidence
+          path: |
+            logs/project-checks/
+            DerivedData/TeamFlowDemo/Logs/Test/*.xcresult
+          if-no-files-found: warn
+          retention-days: 7

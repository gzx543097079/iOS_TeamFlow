diff --git a/App/TeamFlowDemo/Tests/DemoTests.swift b/App/TeamFlowDemo/Tests/DemoTests.swift
new file mode 100644
index 0000000000000000000000000000000000000000..64e61f9139b6d956ad7ce2890c3b395ac580c20e
--- /dev/null
+++ b/App/TeamFlowDemo/Tests/DemoTests.swift
@@ -0,0 +1,35 @@
+import XCTest
+@testable import TeamFlowDemo
+
+final class DemoTests: XCTestCase {
+    func testPlanUsesSamePriceAndPeriod() {
+        let plan = DemoPlan(productID: "fixture.yearly", displayPrice: "$24.99", period: "年")
+        XCTAssertEqual(plan.summary, "$24.99 / 年")
+        XCTAssertEqual(DemoPlan.monthly.summary, "¥6.00 / 月")
+    }
+
+    @MainActor func testNavigationRecordsOneEventAndUsesSelectedPlan() {
+        let events = DemoEvents()
+        let plan = DemoPlan(productID: "fixture.yearly", displayPrice: "¥60.00", period: "年")
+        let controller = DemoViewController(plan: plan, events: events)
+        let navigation = UINavigationController(rootViewController: controller)
+        controller.loadViewIfNeeded()
+        controller.showPlan()
+        XCTAssertEqual(events.names, ["demo_plan_open"])
+        XCTAssertEqual(navigation.topViewController?.title, plan.summary)
+        XCTAssertEqual(navigation.viewControllers.count, 2)
+    }
+
+    @MainActor func testControllerReleasesAfterNavigationIsReleased() {
+        weak var reference: DemoViewController?
+        autoreleasepool {
+            let controller = DemoViewController()
+            reference = controller
+            let navigation = UINavigationController(rootViewController: controller)
+            controller.loadViewIfNeeded()
+            controller.showPlan()
+            _ = navigation.popViewController(animated: false)
+        }
+        XCTAssertNil(reference)
+    }
+}
diff --git a/App/TeamFlowDemo/UITests/DemoUITests.swift b/App/TeamFlowDemo/UITests/DemoUITests.swift
new file mode 100644
index 0000000000000000000000000000000000000000..6ab468151d3a8058293ee1c2fe34ac890eeca515
--- /dev/null
+++ b/App/TeamFlowDemo/UITests/DemoUITests.swift
@@ -0,0 +1,15 @@
+import XCTest
+
+final class DemoUITests: XCTestCase {
+    func testOpenPlanAndReturn() {
+        let app = XCUIApplication()
+        app.launch()
+        XCTAssertTrue(app.buttons["showPlan"].waitForExistence(timeout: 10))
+        XCTAssertTrue(app.staticTexts["planSummary"].label.contains("¥6.00 / 月"))
+        XCTAssertEqual(app.tabBars.count, 0)
+        app.buttons["showPlan"].tap()
+        XCTAssertTrue(app.navigationBars["¥6.00 / 月"].waitForExistence(timeout: 5))
+        app.navigationBars.buttons.element(boundBy: 0).tap()
+        XCTAssertTrue(app.buttons["showPlan"].waitForExistence(timeout: 5))
+    }
+}

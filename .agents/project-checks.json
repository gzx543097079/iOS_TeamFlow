{
  "schema_version": 2,
  "profiles": {
    "workflow": {
      "inputs": [
        ".agents/skills",
        ".github",
        ".gitignore",
        "AGENTS.md",
        "README.md",
        "scripts/teamflow.py",
        "scripts/run_workflow_checks.py",
        "scripts/validate_workflow.py",
        "scripts/package_release.py",
        "scripts/check_logging.py",
        "tests",
        "CHANGELOG.md",
        "docs",
        ".agents/teamflow-core",
        ".claude/settings.json",
        ".codex"
      ],
      "checks": {
        "workflow-tests": {
          "argv": [
            "python3",
            "scripts/run_workflow_checks.py"
          ],
          "cwd": ".",
          "timeout_seconds": 900
        }
      }
    },
    "workflow-docs": {
      "inputs": [
        "AGENTS.md",
        "README.md",
        ".agents/skills/iOS/SKILL.md",
        ".agents/skills/iOS/references",
        "scripts/validate_workflow.py",
        "scripts/package_release.py",
        "CHANGELOG.md",
        "docs",
        ".agents/skills/Godot",
        ".agents/teamflow-core"
      ],
      "checks": {
        "workflow-docs": {
          "argv": [
            "python3",
            "scripts/validate_workflow.py"
          ],
          "timeout_seconds": 60,
          "cwd": "."
        }
      }
    },
    "workflow-release": {
      "extends": "workflow",
      "checks": {
        "workflow-package": {
          "argv": [
            "python3",
            "scripts/package_release.py"
          ],
          "cwd": ".",
          "timeout_seconds": 300
        }
      }
    }
  }
}

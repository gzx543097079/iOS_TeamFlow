{
  "schema_version": 2,
  "profiles": {
    "ios-demo": {
      "inputs": [
        "App/TeamFlowDemo",
        "scripts/test_demo.py"
      ],
      "checks": {
        "ios-demo": {
          "argv": [
            "python3",
            "scripts/test_demo.py"
          ],
          "cwd": ".",
          "timeout_seconds": 900
        },
        "ios-demo-release": {
          "argv": [
            "python3",
            "scripts/test_demo.py",
            "--configuration",
            "Release",
            "--unit-tests-only"
          ],
          "cwd": ".",
          "timeout_seconds": 900
        }
      }
    },
    "workflow": {
      "inputs": [
        ".agents/skills/ios-team-flow",
        ".github",
        ".gitignore",
        "AGENTS.md",
        "README.md",
        "scripts/teamflow.py",
        "scripts/run_workflow_checks.py",
        "scripts/validate_workflow.py",
        "scripts/package_release.py",
        "scripts/check_logging.py",
        "tests"
      ],
      "checks": {
        "workflow-tests": {
          "argv": [
            "python3",
            "scripts/run_workflow_checks.py"
          ],
          "cwd": ".",
          "timeout_seconds": 900
        }
      }
    },
    "workflow-docs": {
      "inputs": [
        "AGENTS.md",
        "README.md",
        ".agents/skills/ios-team-flow/SKILL.md",
        ".agents/skills/ios-team-flow/references",
        "scripts/validate_workflow.py",
        "scripts/package_release.py"
      ],
      "checks": {
        "workflow-docs": {
          "argv": [
            "python3",
            "scripts/validate_workflow.py"
          ],
          "timeout_seconds": 60
        }
      }
    },
    "workflow-release": {
      "inputs": [
        ".agents/skills/ios-team-flow",
        ".github",
        ".gitignore",
        "AGENTS.md",
        "README.md",
        "scripts/teamflow.py",
        "scripts/run_workflow_checks.py",
        "scripts/validate_workflow.py",
        "scripts/package_release.py",
        "scripts/check_logging.py",
        "tests"
      ],
      "checks": {
        "workflow-tests": {
          "argv": [
            "python3",
            "scripts/run_workflow_checks.py"
          ],
          "cwd": ".",
          "timeout_seconds": 900
        },
        "workflow-package": {
          "argv": [
            "python3",
            "scripts/package_release.py"
          ],
          "cwd": ".",
          "timeout_seconds": 300
        }
      }
    }
  }
}

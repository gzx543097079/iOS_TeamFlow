{
  "schema_version": 2,
  "profiles": {
    "ios-demo": {
      "inputs": [
        "App/TeamFlowDemo",
        "scripts/test_demo.py"
      ],
      "checks": {
        "ios-demo": {
          "argv": [
            "python3",
            "scripts/test_demo.py"
          ],
          "cwd": ".",
          "timeout_seconds": 900
        },
        "ios-demo-release": {
          "argv": [
            "python3",
            "scripts/test_demo.py",
            "--configuration",
            "Release",
            "--unit-tests-only"
          ],
          "cwd": ".",
          "timeout_seconds": 900
        }
      }
    },
    "workflow": {
      "inputs": [
        ".agents/skills/ios-team-flow",
        ".agents/project-modules.json",
        ".github",
        ".gitignore",
        "AGENTS.md",
        "README.md",
        "scripts",
        "tests"
      ],
      "checks": {
        "workflow-tests": {
          "argv": [
            "python3",
            "scripts/run_workflow_checks.py"
          ],
          "cwd": ".",
          "timeout_seconds": 900
        },
        "workflow-package": {
          "argv": [
            "python3",
            "scripts/package_release.py"
          ],
          "cwd": ".",
          "timeout_seconds": 300
        }
      }
    }
  }
}

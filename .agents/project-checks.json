{
  "schema_version": 2,
  "profiles": {
    "ios-demo": {
      "inputs": [
        "examples/TeamFlowDemo",
        "scripts/test_demo.py"
      ],
      "checks": {
        "ios-demo": {
          "argv": [
            "python3",
            "scripts/test_demo.py"
          ],
          "cwd": ".",
          "timeout_seconds": 900
        },
        "ios-demo-release": {
          "argv": [
            "python3",
            "scripts/test_demo.py",
            "--configuration",
            "Release",
            "--unit-tests-only"
          ],
          "cwd": ".",
          "timeout_seconds": 900
        }
      }
    },
    "workflow": {
      "inputs": [
        ".agents/skills",
        ".github",
        ".gitignore",
        "AGENTS.md",
        "README.md",
        "scripts/teamflow.py",
        "scripts/run_workflow_checks.py",
        "scripts/validate_workflow.py",
        "scripts/package_release.py",
        "scripts/check_logging.py",
        "tests",
        ".agents/project-modules.json",
        "CHANGELOG.md",
        "docs",
        "examples/TeamFlowGame",
        ".agents/teamflow-core",
        "examples/TeamFlowDemo/README.md",
        "examples/TeamFlowDemo/Resources/zh-Hans.lproj/Localizable.strings",
        "examples/TeamFlowDemo/Resources/en.lproj/Localizable.strings"
      ],
      "checks": {
        "workflow-tests": {
          "argv": [
            "python3",
            "scripts/run_workflow_checks.py"
          ],
          "cwd": ".",
          "timeout_seconds": 900
        }
      }
    },
    "workflow-docs": {
      "inputs": [
        "AGENTS.md",
        "README.md",
        ".agents/skills/iOS/SKILL.md",
        ".agents/skills/iOS/references",
        "scripts/validate_workflow.py",
        "scripts/package_release.py",
        "CHANGELOG.md",
        "docs",
        ".agents/skills/Godot",
        ".agents/teamflow-core"
      ],
      "checks": {
        "workflow-docs": {
          "argv": [
            "python3",
            "scripts/validate_workflow.py"
          ],
          "timeout_seconds": 60,
          "cwd": "."
        }
      }
    },
    "workflow-release": {
      "extends": "workflow",
      "checks": {
        "workflow-package": {
          "argv": [
            "python3",
            "scripts/package_release.py"
          ],
          "cwd": ".",
          "timeout_seconds": 300
        }
      }
    },
    "workflow-godot-review": {
      "extends": "workflow-release",
      "checks": {
        "godot-example": {
          "argv": [
            "python3",
            ".agents/skills/Godot/scripts/verify_godot.py",
            "--project",
            "examples/TeamFlowGame",
            "--test-script",
            "tests/run_tests.gd"
          ],
          "cwd": ".",
          "timeout_seconds": 300
        },
        "demo-strings": {
          "argv": [
            "plutil",
            "-lint",
            "examples/TeamFlowDemo/Resources/zh-Hans.lproj/Localizable.strings",
            "examples/TeamFlowDemo/Resources/en.lproj/Localizable.strings"
          ],
          "cwd": ".",
          "timeout_seconds": 60
        }
      }
    }
  }
}

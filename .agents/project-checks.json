{
  "schema_version": 1,
  "checks": {
    "ios-demo": {
      "argv": [
        "python3",
        "scripts/test_demo.py"
      ],
      "cwd": ".",
      "timeout_seconds": 900
    },
    "ios-demo-release": {
      "argv": [
        "python3",
        "scripts/test_demo.py",
        "--configuration",
        "Release",
        "--unit-tests-only"
      ],
      "cwd": ".",
      "timeout_seconds": 900
    }
  },
  "profiles": {
    "ios-demo": [
      "ios-demo",
      "ios-demo-release"
    ]
  },
  "inputs": [
    "App/TeamFlowDemo",
    "scripts/test_demo.py"
  ]
}

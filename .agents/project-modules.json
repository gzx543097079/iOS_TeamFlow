{
  "schema_version": 2,
  "cross_cutting_paths": [
    "examples/TeamFlowDemo/Sources/Shared",
    "examples/TeamFlowDemo/Sources/Infrastructure",
    "examples/TeamFlowDemo/Resources",
    "examples/TeamFlowDemo/project.yml",
    "examples/TeamFlowDemo/Podfile",
    "examples/TeamFlowDemo/Podfile.lock"
  ],
  "modules": [
    {
      "name": "demo-application",
      "responsibility": "场景生命周期、依赖组装与导航",
      "triggers": [
        "启动",
        "导航",
        "scene",
        "coordinator"
      ],
      "paths": [
        "examples/TeamFlowDemo/Sources/Application"
      ],
      "entry_symbols": [
        "SceneDelegate",
        "DemoCoordinator"
      ],
      "dependencies": [
        "examples/TeamFlowDemo/Sources/Shared",
        "examples/TeamFlowDemo/Sources/Infrastructure"
      ],
      "callers": [
        "TeamFlowDemo"
      ],
      "verification": [
        "ios-demo"
      ]
    },
    {
      "name": "demo-store",
      "responsibility": "商城展示、分类筛选与商品卡片",
      "triggers": [
        "商城",
        "首页",
        "分类",
        "store"
      ],
      "paths": [
        "examples/TeamFlowDemo/Sources/Features/Store"
      ],
      "entry_symbols": [
        "DemoViewController",
        "StoreViewModel"
      ],
      "dependencies": [
        "DemoCatalog",
        "ProductItem"
      ],
      "callers": [
        "DemoCoordinator"
      ],
      "verification": [
        "ios-demo"
      ]
    },
    {
      "name": "demo-product",
      "responsibility": "商品详情与加入购物袋",
      "triggers": [
        "商品详情",
        "加购",
        "product"
      ],
      "paths": [
        "examples/TeamFlowDemo/Sources/Features/Product"
      ],
      "entry_symbols": [
        "ProductViewController",
        "ProductViewModel"
      ],
      "dependencies": [
        "DemoCatalog",
        "ProductItem"
      ],
      "callers": [
        "DemoCoordinator"
      ],
      "verification": [
        "ios-demo"
      ]
    },
    {
      "name": "demo-bag",
      "responsibility": "购物袋列表、金额汇总与逐件减少",
      "triggers": [
        "购物袋",
        "购物车",
        "bag"
      ],
      "paths": [
        "examples/TeamFlowDemo/Sources/Features/Bag"
      ],
      "entry_symbols": [
        "BagViewController",
        "BagViewModel"
      ],
      "dependencies": [
        "DemoCatalog"
      ],
      "callers": [
        "DemoCoordinator"
      ],
      "verification": [
        "ios-demo"
      ]
    },
    {
      "name": "demo-settings",
      "responsibility": "设置、语言、外观与关于页面",
      "triggers": [
        "设置",
        "语言",
        "外观",
        "关于",
        "settings"
      ],
      "paths": [
        "examples/TeamFlowDemo/Sources/Features/Settings"
      ],
      "entry_symbols": [
        "SettingsViewController",
        "SettingsViewModel"
      ],
      "dependencies": [
        "DemoPreferences",
        "ChoicePresenting"
      ],
      "callers": [
        "DemoCoordinator"
      ],
      "verification": [
        "ios-demo"
      ]
    }
  ]
}
